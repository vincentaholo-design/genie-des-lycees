# ────────────────────────────────────────────────────────────────
# Génie des Lycées ORATHON — variables d'environnement (exemple)
# Copiez ce fichier en .env.local et complétez. Ne commitez JAMAIS .env.local.
# Sans aucune variable, le site tourne en mode démonstration avec une base embarquée.
# ────────────────────────────────────────────────────────────────

# Adresse publique du site (liens de partage, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret serveur : 32 caractères aléatoires minimum (empreintes de vote, codes, IP)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ⚠ Ne plus le changer une fois le vote ouvert (les empreintes de votants en dépendent).
APP_SECRET=

# true = codes de vote affichés à l'écran si aucun fournisseur n'est configuré.
# Laisser vide : actif seulement sans DATABASE_URL. Mettre false en production.
DEMO_MODE=

# ── Base de données PostgreSQL (Supabase : Project Settings → Database → Connection string)
# Utilisez l'URI du « Transaction pooler » (port 6543) pour un hébergement serverless.
DATABASE_URL=
DATABASE_POOL_MAX=5

# ── Stockage des médias (Supabase Storage). Côté serveur uniquement.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_PUBLIC=public-media
SUPABASE_BUCKET_PRIVATE=dossiers
SUPABASE_BUCKET_VIDEOS=videos

# ── Vidéos : poids maximum (Mo) et ouverture de l'envoi par le public sans anti-robot
VIDEO_MAX_MB=500
VIDEO_PUBLIC_UPLOAD=

# ── E-mails (codes de vote, confirmations d'inscription) : https://resend.com
RESEND_API_KEY=
MAIL_FROM="Génie des Lycées <no-reply@votre-domaine.tg>"

# ── SMS (codes de vote par SMS) : webhook vers votre fournisseur (reçoit {"to","text"} en JSON)
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ── Anti-robot Cloudflare Turnstile (obligatoire pour le vote « léger » en production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
